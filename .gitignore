# NOTE: '#' only starts a comment at the BEGINNING of a line. A trailing comment
# on the same line as a pattern becomes part of the pattern and silently matches
# nothing, so every comment here is on its own line.

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
# .venv/ was committed by an earlier contributor and is broken on any other
# machine (it hard-codes C:\Users\SidikRoyale\...\python.exe). Untracked via
# `git rm -r --cached .venv` - the directory is still on disk, just not in git.
.venv/
.venv-ml/
.venv-ml313/
venv/
env/

# ---- ML artefacts (all regenerable; see docs/ML_PROGRESS.md) ----
# trained joblib models - rebuilt by scripts/retrain_ml.py
models/
# downloaded third-party corpora (OTRF, ~85 MB) - refetched by ml.datasets.otrf
data/external/
data/interim/
# offline training database - rebuilt by ml.datasets.otrf_etl --rebuild
ml_train.db
ml_train.db-wal
ml_train.db-shm
# generated evaluation figures are committed (they are deliverables);
# only scratch output is ignored
reports_ml/scratch/

# ---- Runtime / local state ----
*.db-wal
*.db-shm
spool/
spool_test/
agent/spool*/

# ---- Test side-effects ----
# The existing suite regenerates incident reports on every run. The 12 reports
# committed by the DFIR track stay tracked (gitignore does not affect already-
# tracked files); this only stops NEW run artefacts being added.
reports_out/incident_report_*.pdf

